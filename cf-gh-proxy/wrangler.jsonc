{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Short workers.dev hostname: https://dl.<account-subdomain>.workers.dev
  "name": "dl",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_REPOS": "snakeJohn/grok-build-mirror",
    "MIRROR_REPO": "snakeJohn/grok-build-mirror",
    "SITE_TITLE": "DL"
  }
  // ACCESS_CODE is a secret — set via: npx wrangler secret put ACCESS_CODE
}
